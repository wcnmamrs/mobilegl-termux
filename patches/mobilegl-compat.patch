+
+    CompatMatrixState& CompatState() {
+        static CompatMatrixState state{};
+        static bool ready = false;
+        if (!ready) {
+            ready = true;
+            for (int m = 0; m < 3; ++m) {
+                for (int i = 0; i < 16; ++i) state.Mat[m][i] = (i % 5 == 0) ? 1.0f : 0.0f;
+                state.Depth[m] = 0;
+            }
+            state.Mode = kCompatModeModelView;
+            state.Generation = 1;
+        }
+        return state;
+    }
+
+    int CompatModeIndex(int mode) {
+        switch (mode) {
+        case kCompatModeProjection: return 1;
+        case kCompatModeTexture: return 2;
+        default: return 0;
+        }
+    }
+
+    // 列主序 4x4：out = a * b
+    void CompatMultiply(float* out, const float* a, const float* b) {
+        for (int c = 0; c < 4; ++c) {
+            for (int r = 0; r < 4; ++r) {
+                float sum = 0.0f;
+                for (int k = 0; k < 4; ++k) sum += a[k * 4 + r] * b[c * 4 + k];
+                out[c * 4 + r] = sum;
+            }
+        }
+    }
+
+    void CompatMultCurrent(const float* m) {
+        CompatMatrixState& st = CompatState();
+        float out[16];
+        CompatMultiply(out, st.Mat[CompatModeIndex(st.Mode)], m);
+        for (int i = 0; i < 16; ++i) st.Mat[CompatModeIndex(st.Mode)][i] = out[i];
+        ++st.Generation;
+    }
+
+    void CompatLoadCurrent(const float* m) {
+        CompatMatrixState& st = CompatState();
+        for (int i = 0; i < 16; ++i) st.Mat[CompatModeIndex(st.Mode)][i] = m[i];
+        ++st.Generation;
+    }
+
+    void CompatLoadIdentity() {
+        float identity[16];
+        for (int i = 0; i < 16; ++i) identity[i] = (i % 5 == 0) ? 1.0f : 0.0f;
+        CompatLoadCurrent(identity);
+    }
+
+    // 3x3 逆转置，取 ModelView 左上角（gl_NormalMatrix 的定义）
+    void CompatNormalMatrix(float* out3x3) {
+        const float* m = CompatState().Mat[0];
+        const float a = m[0], b = m[4], c = m[8];
+        const float d = m[1], e = m[5], f = m[9];
+        const float g = m[2], h = m[6], i = m[10];
+        const float det = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g);
+        if (det == 0.0f) {
+            out3x3[0] = 1; out3x3[1] = 0; out3x3[2] = 0;
+            out3x3[3] = 0; out3x3[4] = 1; out3x3[5] = 0;
+            out3x3[6] = 0; out3x3[7] = 0; out3x3[8] = 1;
+            return;
+        }
+        const float inv = 1.0f / det;
+        // 逆转置，列主序写入
+        out3x3[0] = (e * i - f * h) * inv;
+        out3x3[1] = (f * g - d * i) * inv;
+        out3x3[2] = (d * h - e * g) * inv;
+        out3x3[3] = (c * h - b * i) * inv;
+        out3x3[4] = (a * i - c * g) * inv;
+        out3x3[5] = (b * g - a * h) * inv;
+        out3x3[6] = (b * f - c * e) * inv;
+        out3x3[7] = (c * d - a * f) * inv;
+        out3x3[8] = (a * e - b * d) * inv;
+    }
+
+    // 当前程序由 glUseProgram 记账，避免为了拿它再进一次 GL 状态机
+    GLuint g_CompatCurrentProgram = 0;
+
+    struct CompatUniformCacheEntry {
+        GLuint Program;
+        GLint Mvp;
+        GLint Mv;
+        GLint Projection;
+        GLint Normal;
+        unsigned long long Generation;
+    };
+    CompatUniformCacheEntry g_CompatUniforms[64];
+    int g_CompatUniformCount = 0;
+
+    void CompatUploadImplicitUniforms() {
+        if (g_CompatCurrentProgram == 0) return;
+        CompatMatrixState& st = CompatState();
+
+        CompatUniformCacheEntry* entry = nullptr;
+        for (int i = 0; i < g_CompatUniformCount; ++i) {
+            if (g_CompatUniforms[i].Program == g_CompatCurrentProgram) {
+                entry = &g_CompatUniforms[i];
+                break;
+            }
+        }
+        if (entry == nullptr) {
+            if (g_CompatUniformCount >= 64) return;
+            entry = &g_CompatUniforms[g_CompatUniformCount++];
+            entry->Program = g_CompatCurrentProgram;
+            entry->Mvp = MobileGL::MG_Impl::GLImpl::GetUniformLocation(
+                g_CompatCurrentProgram, "mg_ModelViewProjectionMatrix");
+            entry->Mv = MobileGL::MG_Impl::GLImpl::GetUniformLocation(
+                g_CompatCurrentProgram, "mg_ModelViewMatrix");
+            entry->Projection = MobileGL::MG_Impl::GLImpl::GetUniformLocation(
+                g_CompatCurrentProgram, "mg_ProjectionMatrix");
+            entry->Normal = MobileGL::MG_Impl::GLImpl::GetUniformLocation(
+                g_CompatCurrentProgram, "mg_NormalMatrix");
+            entry->Generation = 0;
+            MGLOG_D("compat matrices: program %u wants mvp=%d mv=%d proj=%d normal=%d",
+                    g_CompatCurrentProgram, entry->Mvp, entry->Mv, entry->Projection, entry->Normal);
+        }
+        if (entry->Generation == st.Generation) return;
+        entry->Generation = st.Generation;
+        if (entry->Mvp < 0 && entry->Mv < 0 && entry->Projection < 0 && entry->Normal < 0) return;
+
+        float mvp[16];
+        CompatMultiply(mvp, st.Mat[1], st.Mat[0]);
+        if (entry->Mvp >= 0) MobileGL::MG_Impl::GLImpl::UniformMatrix4fv(entry->Mvp, 1, GL_FALSE, mvp);
+        if (entry->Mv >= 0) MobileGL::MG_Impl::GLImpl::UniformMatrix4fv(entry->Mv, 1, GL_FALSE, st.Mat[0]);
+        if (entry->Projection >= 0)
+            MobileGL::MG_Impl::GLImpl::UniformMatrix4fv(entry->Projection, 1, GL_FALSE, st.Mat[1]);
+        if (entry->Normal >= 0) {
+            float normal[9];
+            CompatNormalMatrix(normal);
+            MobileGL::MG_Impl::GLImpl::UniformMatrix3fv(entry->Normal, 1, GL_FALSE, normal);
+        }
+    }
+
+    void CompatOrthoCurrent(double l, double r, double b, double t, double n, double f) {
+        float m[16] = {0};
+        m[0] = (float)(2.0 / (r - l));
+        m[5] = (float)(2.0 / (t - b));
+        m[10] = (float)(-2.0 / (f - n));
+        m[12] = (float)(-(r + l) / (r - l));
+        m[13] = (float)(-(t + b) / (t - b));
+        m[14] = (float)(-(f + n) / (f - n));
+        m[15] = 1.0f;
+        CompatMultCurrent(m);
+    }
+
+    void CompatFrustumCurrent(double l, double r, double b, double t, double n, double f) {
+        float m[16] = {0};
+        m[0] = (float)(2.0 * n / (r - l));
+        m[5] = (float)(2.0 * n / (t - b));
+        m[8] = (float)((r + l) / (r - l));
+        m[9] = (float)((t + b) / (t - b));
+        m[10] = (float)(-(f + n) / (f - n));
+        m[11] = -1.0f;
+        m[14] = (float)(-2.0 * f * n / (f - n));
+        CompatMultCurrent(m);
+    }
+
+    void CompatRotateCurrent(double angle, double x, double y, double z) {
+        const double len = std::sqrt(x * x + y * y + z * z);
+        if (len == 0.0) return;
+        x /= len; y /= len; z /= len;
+        const double rad = angle * 3.14159265358979323846 / 180.0;
+        const double c = std::cos(rad), s = std::sin(rad);
+        float m[16] = {0};
+        m[0] = (float)(x * x * (1 - c) + c);
+        m[1] = (float)(y * x * (1 - c) + z * s);
+        m[2] = (float)(x * z * (1 - c) - y * s);
+        m[4] = (float)(x * y * (1 - c) - z * s);
+        m[5] = (float)(y * y * (1 - c) + c);
+        m[6] = (float)(y * z * (1 - c) + x * s);
+        m[8] = (float)(x * z * (1 - c) + y * s);
+        m[9] = (float)(y * z * (1 - c) - x * s);
+        m[10] = (float)(z * z * (1 - c) + c);
+        m[15] = 1.0f;
+        CompatMultCurrent(m);
+    }
+
+    void CompatScaleCurrent(double x, double y, double z) {
+        float m[16] = {0};
+        m[0] = (float)x; m[5] = (float)y; m[10] = (float)z; m[15] = 1.0f;
+        CompatMultCurrent(m);
+    }
+
+    void CompatTranslateCurrent(double x, double y, double z) {
+        float m[16] = {0};
+        m[0] = 1; m[5] = 1; m[10] = 1; m[15] = 1;
+        m[12] = (float)x; m[13] = (float)y; m[14] = (float)z;
+        CompatMultCurrent(m);
+    }
+} // namespace
+
+MOBILEGL_GL_API void glMatrixMode(GLenum mode) {
+    CompatMatrixState& st = CompatState();
+    st.Mode = (int)mode;
+}
+
+MOBILEGL_GL_API void glLoadIdentity() { CompatLoadIdentity(); }
+
+MOBILEGL_GL_API void glLoadMatrixf(const GLfloat* m) {
+    if (m != nullptr) CompatLoadCurrent(m);
+}
+
+MOBILEGL_GL_API void glLoadMatrixd(const GLdouble* m) {
+    if (m == nullptr) return;
+    float f[16];
+    for (int i = 0; i < 16; ++i) f[i] = (float)m[i];
+    CompatLoadCurrent(f);
+}
+
+MOBILEGL_GL_API void glMultMatrixf(const GLfloat* m) {
+    if (m != nullptr) CompatMultCurrent(m);
+}
+
+MOBILEGL_GL_API void glMultMatrixd(const GLdouble* m) {
+    if (m == nullptr) return;
+    float f[16];
+    for (int i = 0; i < 16; ++i) f[i] = (float)m[i];
+    CompatMultCurrent(f);
+}
+
+MOBILEGL_GL_API void glPushMatrix() {
+    CompatMatrixState& st = CompatState();
+    const int idx = CompatModeIndex(st.Mode);
+    if (st.Depth[idx] >= 31) return;
+    for (int i = 0; i < 16; ++i) st.Stack[idx][st.Depth[idx]][i] = st.Mat[idx][i];
+    ++st.Depth[idx];
+}
+
+MOBILEGL_GL_API void glPopMatrix() {
+    CompatMatrixState& st = CompatState();
+    const int idx = CompatModeIndex(st.Mode);
+    if (st.Depth[idx] <= 0) return;
+    --st.Depth[idx];
+    for (int i = 0; i < 16; ++i) st.Mat[idx][i] = st.Stack[idx][st.Depth[idx]][i];
+    ++st.Generation;
+}
+
+MOBILEGL_GL_API void glOrtho(GLdouble l, GLdouble r, GLdouble b, GLdouble t, GLdouble n, GLdouble f) {
+    CompatOrthoCurrent(l, r, b, t, n, f);
+}
+
+MOBILEGL_GL_API void glFrustum(GLdouble l, GLdouble r, GLdouble b, GLdouble t, GLdouble n, GLdouble f) {
+    CompatFrustumCurrent(l, r, b, t, n, f);
+}
+
+MOBILEGL_GL_API void glRotatef(GLfloat angle, GLfloat x, GLfloat y, GLfloat z) {
+    CompatRotateCurrent(angle, x, y, z);
+}
+
+MOBILEGL_GL_API void glRotated(GLdouble angle, GLdouble x, GLdouble y, GLdouble z) {
+    CompatRotateCurrent(angle, x, y, z);
+}
+
+MOBILEGL_GL_API void glScalef(GLfloat x, GLfloat y, GLfloat z) { CompatScaleCurrent(x, y, z); }
+
+MOBILEGL_GL_API void glScaled(GLdouble x, GLdouble y, GLdouble z) { CompatScaleCurrent(x, y, z); }
+
+MOBILEGL_GL_API void glTranslatef(GLfloat x, GLfloat y, GLfloat z) { CompatTranslateCurrent(x, y, z); }
+
+MOBILEGL_GL_API void glTranslated(GLdouble x, GLdouble y, GLdouble z) { CompatTranslateCurrent(x, y, z); }
+
