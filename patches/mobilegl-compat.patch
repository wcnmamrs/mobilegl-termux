+// SPDX-License-Identifier: LGPL-3.0-only
+// End of Source File Header
+
+#pragma once
+
+// EGL WINDOW SURFACES ON AN X SERVER.
+//
+// An X11 window is the same thing to present into whether its frames came from a GLX context or an
+// EGL one: a drawable the X server composites. So an EGL window surface on an X display attaches to
+// the very chain GLX uses (DRI3 + Present shared images, then MIT-SHM, then PutImage) instead of
+// growing a second copy of that logic. The frames come from the surface's own storage - the same
+// EGL surface the application draws into - through X11Present::Chain.
+//
+// Everything here is X11-only; Android and Wayland builds never see these entry points.
+
+#include <Includes.h>
+
+#if defined(__linux__) && !defined(__ANDROID__)
+
+namespace MobileGL::MG_Impl::GLXImpl::X11WindowPresent {
+    // The drawable geometry and depth of an X window, through libxcb/libX11 looked up at runtime
+    // (this library links neither). False when the handle is not an X window at all - the caller
+    // then leaves the surface alone instead of guessing.
+    Bool QueryGeometry(void* xDisplay, Uint64 window, Uint32* width, Uint32* height, Uint32* depth);
+
+    // An X display for a client that named none (EGL_DEFAULT_DISPLAY). Cached for the process; null
+    // when DISPLAY leads nowhere.
+    void* DefaultXDisplay();
+
+    // Attach an EGL window surface to the present chain of (xDisplay, window). The size is what the
+    // caller rendered into; the depth is the window's.
+    Bool Attach(EGLDisplay dpy, EGLSurface surface, void* xDisplay, Uint64 window, Uint32 width, Uint32 height,
+                Uint32 depth);
+
+    // Present the frame currently drawn into the attached surface. Called BEFORE the EGL swap: the
+    // chain copies what the draw framebuffer holds right now. False when nothing was attached.
+    Bool Present(EGLDisplay dpy, EGLSurface surface);
+
+    void Detach(EGLSurface surface);
+} // namespace MobileGL::MG_Impl::GLXImpl::X11WindowPresent
+
+#endif
