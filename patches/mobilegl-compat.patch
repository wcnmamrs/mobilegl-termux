+        if (entry->Mv >= 0) MobileGL::MG_Impl::GLImpl::UniformMatrix4fv(entry->Mv, 1, GL_FALSE, st.Mat[0]);
+        if (entry->Projection >= 0)
+            MobileGL::MG_Impl::GLImpl::UniformMatrix4fv(entry->Projection, 1, GL_FALSE, st.Mat[1]);
+        if (entry->Normal >= 0) {
+            float normal[9];
+            CompatNormalMatrix(normal);
+            MobileGL::MG_Impl::GLImpl::UniformMatrix3fv(entry->Normal, 1, GL_FALSE, normal);
+        }
+    }
+
+    void CompatOrthoCurrent(double l, double r, double b, double t, double n, double f) {
+        float m[16] = {0};
+        m[0] = (float)(2.0 / (r - l));
+        m[5] = (float)(2.0 / (t - b));
+        m[10] = (float)(-2.0 / (f - n));
+        m[12] = (float)(-(r + l) / (r - l));
+        m[13] = (float)(-(t + b) / (t - b));
+        m[14] = (float)(-(f + n) / (f - n));
+        m[15] = 1.0f;
+        CompatMultCurrent(m);
+    }
+
+    void CompatFrustumCurrent(double l, double r, double b, double t, double n, double f) {
+        float m[16] = {0};
+        m[0] = (float)(2.0 * n / (r - l));
+        m[5] = (float)(2.0 * n / (t - b));
+        m[8] = (float)((r + l) / (r - l));
+        m[9] = (float)((t + b) / (t - b));
+        m[10] = (float)(-(f + n) / (f - n));
+        m[11] = -1.0f;
+        m[14] = (float)(-2.0 * f * n / (f - n));
+        CompatMultCurrent(m);
+    }
+
+    void CompatRotateCurrent(double angle, double x, double y, double z) {
+        const double len = std::sqrt(x * x + y * y + z * z);
+        if (len == 0.0) return;
+        x /= len; y /= len; z /= len;
+        const double rad = angle * 3.14159265358979323846 / 180.0;
+        const double c = std::cos(rad), s = std::sin(rad);
+        float m[16] = {0};
+        m[0] = (float)(x * x * (1 - c) + c);
+        m[1] = (float)(y * x * (1 - c) + z * s);
+        m[2] = (float)(x * z * (1 - c) - y * s);
+        m[4] = (float)(x * y * (1 - c) - z * s);
+        m[5] = (float)(y * y * (1 - c) + c);
+        m[6] = (float)(y * z * (1 - c) + x * s);
+        m[8] = (float)(x * z * (1 - c) + y * s);
+        m[9] = (float)(y * z * (1 - c) - x * s);
+        m[10] = (float)(z * z * (1 - c) + c);
+        m[15] = 1.0f;
+        CompatMultCurrent(m);
+    }
+
+    void CompatScaleCurrent(double x, double y, double z) {
+        float m[16] = {0};
+        m[0] = (float)x; m[5] = (float)y; m[10] = (float)z; m[15] = 1.0f;
+        CompatMultCurrent(m);
+    }
+
+    void CompatTranslateCurrent(double x, double y, double z) {
+        float m[16] = {0};
+        m[0] = 1; m[5] = 1; m[10] = 1; m[15] = 1;
+        m[12] = (float)x; m[13] = (float)y; m[14] = (float)z;
+        CompatMultCurrent(m);
+    }
+} // namespace
+
+MOBILEGL_GL_API void glMatrixMode(GLenum mode) {
+    CompatMatrixState& st = CompatState();
+    st.Mode = (int)mode;
+}
+
+MOBILEGL_GL_API void glLoadIdentity() { CompatLoadIdentity(); }
+
+MOBILEGL_GL_API void glLoadMatrixf(const GLfloat* m) {
+    if (m != nullptr) CompatLoadCurrent(m);
+}
+
+MOBILEGL_GL_API void glLoadMatrixd(const GLdouble* m) {
+    if (m == nullptr) return;
+    float f[16];
+    for (int i = 0; i < 16; ++i) f[i] = (float)m[i];
+    CompatLoadCurrent(f);
+}
+
+MOBILEGL_GL_API void glMultMatrixf(const GLfloat* m) {
+    if (m != nullptr) CompatMultCurrent(m);
+}
+
+MOBILEGL_GL_API void glMultMatrixd(const GLdouble* m) {
+    if (m == nullptr) return;
+    float f[16];
+    for (int i = 0; i < 16; ++i) f[i] = (float)m[i];
+    CompatMultCurrent(f);
+}
+
+MOBILEGL_GL_API void glPushMatrix() {
+    CompatMatrixState& st = CompatState();
+    const int idx = CompatModeIndex(st.Mode);
+    if (st.Depth[idx] >= 31) return;
+    for (int i = 0; i < 16; ++i) st.Stack[idx][st.Depth[idx]][i] = st.Mat[idx][i];
+    ++st.Depth[idx];
+}
+
+MOBILEGL_GL_API void glPopMatrix() {
+    CompatMatrixState& st = CompatState();
+    const int idx = CompatModeIndex(st.Mode);
+    if (st.Depth[idx] <= 0) return;
+    --st.Depth[idx];
+    for (int i = 0; i < 16; ++i) st.Mat[idx][i] = st.Stack[idx][st.Depth[idx]][i];
+    ++st.Generation;
+}
+
+MOBILEGL_GL_API void glOrtho(GLdouble l, GLdouble r, GLdouble b, GLdouble t, GLdouble n, GLdouble f) {
+    CompatOrthoCurrent(l, r, b, t, n, f);
+}
+
+MOBILEGL_GL_API void glFrustum(GLdouble l, GLdouble r, GLdouble b, GLdouble t, GLdouble n, GLdouble f) {
+    CompatFrustumCurrent(l, r, b, t, n, f);
+}
+
+MOBILEGL_GL_API void glRotatef(GLfloat angle, GLfloat x, GLfloat y, GLfloat z) {
+    CompatRotateCurrent(angle, x, y, z);
+}
+
+MOBILEGL_GL_API void glRotated(GLdouble angle, GLdouble x, GLdouble y, GLdouble z) {
+    CompatRotateCurrent(angle, x, y, z);
+}
+
+MOBILEGL_GL_API void glScalef(GLfloat x, GLfloat y, GLfloat z) { CompatScaleCurrent(x, y, z); }
+
+MOBILEGL_GL_API void glScaled(GLdouble x, GLdouble y, GLdouble z) { CompatScaleCurrent(x, y, z); }
+
+MOBILEGL_GL_API void glTranslatef(GLfloat x, GLfloat y, GLfloat z) { CompatTranslateCurrent(x, y, z); }
+
+MOBILEGL_GL_API void glTranslated(GLdouble x, GLdouble y, GLdouble z) { CompatTranslateCurrent(x, y, z); }
